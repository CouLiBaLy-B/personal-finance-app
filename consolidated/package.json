{
  "name": "fintrack",
  "version": "1.0.0",
  "description": "FinTrack — Application de gestion financière personnelle (Version Consolidée)",
  "private": true,
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:full": "npm run build && npm run build:backend",
    "prisma:generate": "cd backend && npm run prisma:generate",
    "prisma:migrate": "cd backend && npm run prisma:migrate",
    "prisma:studio": "cd backend && npm run prisma:studio",
    "prisma:seed": "cd backend && npm run seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose exec backend npx prisma db seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
