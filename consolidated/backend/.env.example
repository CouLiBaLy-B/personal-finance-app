# ============ Server ============
NODE_ENV=development
PORT=4000

# ============ Database ============
DATABASE_URL=postgresql://fintrack:fintrack_pwd@localhost:5432/fintrack?schema=public

# ============ JWT ============
# IMPORTANT: Change this in production! App refuses to start with default value.
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# ============ CORS ============
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# ============ OAuth2 Google (optional) ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ============ File Uploads ============
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ============ Exchange Rate API ============
FX_API_KEY=
FX_PROVIDER=exchangerate-api

# ============ Logging ============
LOG_LEVEL=info
