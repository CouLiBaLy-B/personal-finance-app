# ========================
# FinTrack — Frontend (Vite → Nginx statique)
# Multi-stage build : build Vite → copie dans /usr/share/nginx/html
# ========================

# ---------- Stage 1 : build ----------
FROM node:20-alpine AS builder
WORKDIR /app

# Dépendances
COPY package.json ./
COPY package-lock.json* ./
RUN npm install

# Copie + build Vite
COPY . .
RUN npm run build

# ---------- Stage 2 : Nginx ----------
FROM nginx:alpine AS runtime
ENV NODE_ENV=production

# Copie du build
COPY --from=builder /app/dist /usr/share/nginx/html

# Configuration Nginx : SPA fallback (index.html pour toutes les routes)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
