# ============================
# FinTrack — Exemple de .env
# Copiez ce fichier dans .env (ne jamais commiter .env)
# ============================

# ---------- PostgreSQL ----------
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack_pwd_32chars_min
POSTGRES_DB=fintrack

# ---------- Backend ----------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# ---------- Base de données ----------
DATABASE_URL=postgresql://fintrack:fintrack_pwd_32chars_min@localhost:5432/fintrack?schema=public

# ---------- JWT ----------
# Minimum 32 caractères aléatoires. En production : utiliser un gestionnaire de secrets.
JWT_SECRET=change-me-in-production-please-use-a-strong-random-string-of-32-chars-min
JWT_EXPIRES_IN=30d

# ---------- OAuth2 — Google ----------
# Créez un projet sur https://console.cloud.google.com/ > API & services > Identifiants
# Type : ID client OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback

# ---------- OAuth2 — Apple (optionnel) ----------
# Sur https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=com.fintrack.web
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...base64...\n-----END PRIVATE KEY-----
